### GET request to example server
GET https://examples.http-client.intellij.net/get
    ?generated-in=IntelliJ IDEA


### Create a restaurant
POST http://localhost:8080/api/restaurants
Content-Type: application/json

{
  "ownerId": "8c8c87c1-9b5f-4f73-9fa7-7f9b5c7f2296",
  "name": "La Petite Maison",
  "address": {
    "street": "Main Street",
    "number": 42,
    "postalCode": "1000",
    "city": "Brussels",
    "country": "Belgium"
  },
  "contactEmail": "contact@lapetitemaison.be",
  "cuisineType": "FRENCH",
  "defaultPreparationTime": 30,
  "openingHours": {
    "MONDAY": { "open": "09:00:00", "closed": "17:00:00" },
    "SATURDAY": { "open": "10:00:00", "closed": "22:00:00" }
  },
  "pictureUrls": [
    "https://example.com/pictures/restaurant-front.jpg",
    "https://example.com/pictures/restaurant-inside.jpg"
  ]
}

### Set Opening Hours
PATCH http://localhost:8080/api/restaurants/{{restaurantId}}/opening-hours
Content-Type: application/json

{
  "schedule": {
    "WEDNESDAY": { "open": "09:00:00", "closed": "22:00:00"},
    "SATURDAY": { "open": "09:00:00", "closed": "19:00:00" }
  }

}



### Change Restaurant Status (Open/Closed)
PATCH http://localhost:8080/api/restaurants/{{restaurantId}}/status
Content-Type: application/json

{
  "status": "MANUALLY_CLOSED"
}

### Create a Dish
@restaurantId =e8b6df9e-0a3c-420c-881f-3daca0970aea
POST http://localhost:8080/api/{{restaurantId}}/dishes/new
Content-Type: application/json

{
  "name": "Poulet-DG",
  "type": "MAIN",
  "foodTags":  ["SPICY"],
  "description": "Fried chicken + fried plantians and veggies",
  "price":  20.0,
  "pictureUrl": "https://example.com/pictures/dish.jpg"

}

### Publish Dish
@dishId = 1363fa19-0055-487d-9766-6f177c30922e
POST http://localhost:8080/api/{{restaurantId}}/dishes/{{dishId}}/publish
Content-Type: application/json
Accept: application/json

###
# curl -X POST http://localhost:8180/realms/keepdishesgoing/protocol/openid-connect/token
#  -H "Content-Type: application/x-www-form-urlencoded"
#  -d "grant_type=password"
#  -d "client_id=backend-client"
#  -d "client_secret=YOUR_CLIENT_SECRET"
#  -d "username=owner"
#  -d "password=owner"
POST http://localhost:8180/realms/keepdishesgoing/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type = password &
client_id = backend-client &
client_secret = REMOVED-SECRET &
username = owner &
password = owner

###
# curl -H "Authorization: Bearer YOUR_ACCESS_TOKEN"
#  http://localhost:8080/api/owner/restaurants/me
GET http://localhost:8080/api/restaurants/me
Authorization: Bearer REMOVED-SECRET",



