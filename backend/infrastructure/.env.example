# Optional. Docker Compose reads a .env file next to docker-compose.yaml.
# Every value below is already the default, so the stack runs without one.
# Copy to .env to change them. If you change the database or RabbitMQ
# credentials, export the same variables before starting the backend, which
# reads them with the same defaults.

# Application database (PostgreSQL)
APP_DB_USER=user
APP_DB_PASSWORD=password

# Message broker
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password

# Keycloak and its MySQL store
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
IDP_DB_PASSWORD=password
IDP_DB_ROOT_PASSWORD=root

# Delivery simulator timing, in seconds after the kitchen marks an order ready
DELIVERY_PICKUP_DELAY_SECONDS=10
DELIVERY_LOCATION_INTERVAL_SECONDS=3
DELIVERY_LOCATION_UPDATES=10
