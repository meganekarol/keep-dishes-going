# Local development. Committed on purpose: these are addresses, not secrets —
# the Keycloak client is public, so it has no secret to leak. Override anything
# here in a git-ignored .env.local.
VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=keepdishesgoing
VITE_KEYCLOAK_CLIENT_ID=frontend-client
